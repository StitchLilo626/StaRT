{
    "version": 2,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 20,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "stm32-arm-base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/arm-none-eabi.cmake"
            }
        },
        {
            "name": "stm32-debug",
            "displayName": "STM32F103C8 Debug",
            "inherits": "stm32-arm-base",
            "cacheVariables": {
                "START_ARM_BOARD": "stm32f103c8",
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "stm32-size",
            "displayName": "STM32F103C8 MinSizeRel",
            "inherits": "stm32-arm-base",
            "cacheVariables": {
                "START_ARM_BOARD": "stm32f103c8",
                "CMAKE_BUILD_TYPE": "MinSizeRel"
            }
        },
        {
            "name": "nucleo-f439zi",
            "displayName": "NUCLEO-F439ZI GNU Arm",
            "inherits": "stm32-arm-base",
            "cacheVariables": {
                "START_ARM_BOARD": "nucleo-f439zi",
                "CMAKE_BUILD_TYPE": "MinSizeRel"
            }
        },
        {
            "name": "stc8h8k64u",
            "displayName": "STC8H8K64U SDCC",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/sdcc-mcs51.cmake"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "stm32-debug",
            "configurePreset": "stm32-debug"
        },
        {
            "name": "stm32-size",
            "configurePreset": "stm32-size"
        },
        {
            "name": "nucleo-f439zi",
            "configurePreset": "nucleo-f439zi"
        },
        {
            "name": "stc8h8k64u",
            "configurePreset": "stc8h8k64u"
        }
    ]
}
